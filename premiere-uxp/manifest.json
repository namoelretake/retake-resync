{
  "manifestVersion": 5,
  "id": "com.retakefilmes.resync.premiere",
  "name": "ReSync for Premiere",
  "shortname": "ReSync",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.2.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": [
        "resync"
      ],
      "extensions": []
    }
  },
  "entrypoints": [
    {
      "id": "resyncPanel",
      "type": "panel",
      "label": {
        "default": "ReSync"
      },
      "minimumSize": {
        "width": 260,
        "height": 340
      },
      "maximumSize": {
        "width": 1600,
        "height": 1800
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 570
      },
      "preferredFloatingSize": {
        "width": 390,
        "height": 600
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/r.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "lightest",
            "light"
          ]
        }
      ]
    }
  ]
}
